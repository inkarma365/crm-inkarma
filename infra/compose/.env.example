# Copia in .env sulla VPS (mai nel repo). Genera i segreti con: infra/scripts/gen-env.sh
SERVER_URL=http://localhost:33000

PG_DATABASE_USER=postgres
PG_DATABASE_NAME=default
PG_DATABASE_PASSWORD=            # openssl rand -hex 32
HUB_DB_PASSWORD=                 # openssl rand -hex 32
ENCRYPTION_KEY=                  # openssl rand -base64 32 — perderla rende illeggibili i segreti salvati
FALLBACK_ENCRYPTION_KEY=

EMAIL_FROM_ADDRESS=crm@inkarma.test
EMAIL_FROM_NAME=CRM inKarma

# Variabili facoltative di Twenty (AI via OpenRouter, logic function): in twenty-extra.env,
# vedi twenty-extra.env.example. Non lasciare variabili vuote: Twenty le rifiuta.
